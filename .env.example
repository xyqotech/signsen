# Public URL of your instance (used in e-mails, QR codes and cookies).
APP_URL=https://sign.example.org

# PostgreSQL — with docker compose: the password of the bundled database.
# Required, no default. It is embedded in a connection URL: use letters and
# digits only, e.g. the output of `openssl rand -hex 24`.
POSTGRES_PASSWORD=

# PostgreSQL — without docker compose (or with a server of your own): the full
# connection string. docker compose sets it itself from POSTGRES_PASSWORD.
# DATABASE_URL=postgres://signsen:change-me@localhost:5432/signsen

# Where documents, the seal and the instance key live. Back this up, together
# with a dump of the database.
DATA_DIR=/data

# docker compose only: host port SignSen listens on (bound to 127.0.0.1).
# SIGNSEN_HOST_PORT=3000

# White label
APP_NAME=SignSen
BRAND_COLOR=#1f6f5c
# BRAND_LOGO_URL=https://sign.example.org/logo.svg
DEFAULT_LOCALE=fr
# SUPPORT_EMAIL=support@example.org

# Set to false once your team has its accounts.
ALLOW_SIGNUP=true

# E-mail: smtp in production; "file" writes messages to DATA_DIR/outbox, "console" logs them.
MAIL_TRANSPORT=smtp
MAIL_FROM="SignSen <no-reply@example.org>"
SMTP_URL=smtps://user:password@smtp.example.org:465

# Sign-in attempts allowed per IP address and 15 minutes.
SIGNIN_IP_LIMIT=50

# Optional: your own seal certificate (PKCS#12). Without it, a self-signed seal is
# generated on first start in DATA_DIR/seal.
# SEAL_P12_PATH=/data/my-seal.p12
# SEAL_P12_PASSWORD=change-me
